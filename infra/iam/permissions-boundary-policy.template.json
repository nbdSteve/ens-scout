{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteTheStackLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:ap-southeast-2:${ACCOUNT_ID}:log-group:EnsScout-prod-*",
        "arn:aws:logs:ap-southeast-2:${ACCOUNT_ID}:log-group:EnsScout-prod-*:*"
      ]
    },
    {
      "Sid": "UseTheSnapshotTableItems",
      "Effect": "Allow",
      "Action": [
        "dynamodb:BatchWriteItem",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Query",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-2:${ACCOUNT_ID}:table/EnsScout-prod-*"
    },
    {
      "Sid": "ReadTheStackAssets",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucket*",
        "s3:GetObject*",
        "s3:List*"
      ],
      "Resource": [
        "arn:aws:s3:::cdk-hnb659fds-assets-${ACCOUNT_ID}-ap-southeast-2",
        "arn:aws:s3:::cdk-hnb659fds-assets-${ACCOUNT_ID}-ap-southeast-2/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "${ACCOUNT_ID}"
        }
      }
    },
    {
      "Sid": "CopyTheWebsiteIntoItsPrivateBucket",
      "Effect": "Allow",
      "Action": [
        "s3:Abort*",
        "s3:DeleteObject*",
        "s3:GetBucket*",
        "s3:GetObject*",
        "s3:List*",
        "s3:PutObject",
        "s3:PutObjectLegalHold",
        "s3:PutObjectRetention",
        "s3:PutObjectTagging",
        "s3:PutObjectVersionTagging"
      ],
      "Resource": [
        "arn:aws:s3:::ensscout-prod-*",
        "arn:aws:s3:::ensscout-prod-*/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "${ACCOUNT_ID}"
        }
      }
    }
  ]
}
