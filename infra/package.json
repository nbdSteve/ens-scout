{
  "name": "ens-scout-infra",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript AWS CDK application that defines the ENS Scout AWS architecture",
  "bin": {
    "ens-scout-infra": "bin/ens-scout.js"
  },
  "scripts": {
    "bundle": "node scripts/bundle-scanner.js",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "lint": "tsc --noEmit",
    "check": "npm run lint && npm test && npm run synth -- --quiet"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "20.17.19",
    "aws-cdk": "2.1139.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.267.0",
    "constructs": "10.5.0"
  }
}
