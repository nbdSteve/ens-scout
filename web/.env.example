# ENS Scout website configuration.
#
# Every value here is public: Vite inlines VITE_* variables into the built
# JavaScript. Never put an API key, a Graph endpoint, or an AWS credential in
# this file or in any .env file under web/.

# Base URL of the ENS Scout read API, for example https://api.example.com.
# Leave empty to run entirely from the committed fixture snapshots in
# data/fixtures/, which is the default clean-clone development path.
VITE_API_BASE_URL=

# Which committed fixture to load when no API base URL is configured.
# One of: preview, stale.
VITE_FIXTURE=preview
